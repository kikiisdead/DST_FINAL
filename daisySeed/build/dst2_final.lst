  15:dead_fft.h    ****     /**
  16:dead_fft.h    ****      * @brief Hermite Interpolation
  17:dead_fft.h    ****      * 
  18:dead_fft.h    ****      * @param array to interpolate from
  19:dead_fft.h    ****      * @param pos within array needing access
  20:dead_fft.h    ****      * @param size size of the array
  21:dead_fft.h    ****      * @return float 
  22:dead_fft.h    ****      */
  23:dead_fft.h    ****     static float interpolate(float* array, float pos, int size) {
  24:dead_fft.h    ****         
  25:dead_fft.h    ****         int integral   = static_cast<int>(pos);
ARM GAS  /var/folders/41/s_9r3f9s4p3_9jgx7wszdkhh0000gn/T//ccDOydHt.s 			page 64


  26:dead_fft.h    ****         float fractional = pos - integral;
  27:dead_fft.h    **** 
  28:dead_fft.h    ****         float xm1 = array[(integral - 1 + size) % size];
  29:dead_fft.h    ****         float x0  = array[(integral     + size) % size];
  30:dead_fft.h    ****         float x1  = array[(integral + 1 + size) % size];
  31:dead_fft.h    ****         float x2  = array[(integral + 2 + size) % size];
  32:dead_fft.h    **** 
  33:dead_fft.h    ****         float c = (x1 - xm1) * 0.5;
  34:dead_fft.h    ****         float v = x0 - x1;
  35:dead_fft.h    ****         float w = c + v;
  36:dead_fft.h    ****         float a = w + v + (x2 - x0) * 0.5;
  37:dead_fft.h    ****         float b_neg = w + a;
  38:dead_fft.h    ****         float f = fractional;
  39:dead_fft.h    **** 
  40:dead_fft.h    ****         return (((a * f) - b_neg) * f + c) * f + x0; // the interpolated sample
  41:dead_fft.h    ****     }
