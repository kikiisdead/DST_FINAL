  94:dead_fft.h    ****     /**
  95:dead_fft.h    ****      * @brief Implementation of the Cooley-Turkey divide and conquer FFT
  96:dead_fft.h    ****      * 
  97:dead_fft.h    ****      * @param in_real incoming sequence of data
  98:dead_fft.h    ****      * @param N length of data / size of FFT window
  99:dead_fft.h    ****      * @return complex<double>* 
 100:dead_fft.h    ****      */
 101:dead_fft.h    ****     static C* FFT(float* in_real, int N) {
 102:dead_fft.h    ****         C in[N];
 103:dead_fft.h    ****         for (int i = 0; i < N; i ++) {
 104:dead_fft.h    ****             in[i] = C(in_real[i]);
 105:dead_fft.h    ****         }
 106:dead_fft.h    ****         C* out = new C[N]{};
 107:dead_fft.h    ****         FFT_recursion(in, 0, N, out, 0, 1);
 108:dead_fft.h    ****         return out;
 109:dead_fft.h    ****     }
 110:dead_fft.h    **** 
 111:dead_fft.h    ****     /**
 112:dead_fft.h    ****      * @brief Inverse fourier transform
 113:dead_fft.h    ****      * 
 114:dead_fft.h    ****      * @param in complex input to transform
 115:dead_fft.h    ****      * @param N window size
 116:dead_fft.h    ****      * @return float* 
ARM GAS  /var/folders/41/s_9r3f9s4p3_9jgx7wszdkhh0000gn/T//ccDOydHt.s 			page 161


 117:dead_fft.h    ****      */
 118:dead_fft.h    ****     static float* IFFT(C* in, int N) {
 119:dead_fft.h    ****         C out[N]{0};
 120:dead_fft.h    ****         for (int n = 0; n < N; n++) {
 121:dead_fft.h    ****             in[n] = conj(in[n]);
 122:dead_fft.h    ****         }
 123:dead_fft.h    ****         FFT_recursion(in, 0, N, out, 0, 1);
 124:dead_fft.h    **** 
 125:dead_fft.h    ****         float* out_real = new float[N]{};
 126:dead_fft.h    ****         for (int n = 0; n < N; n ++) {
 127:dead_fft.h    ****             out_real[n] = out[n].real() / static_cast<float>(N);
 128:dead_fft.h    ****         }
 129:dead_fft.h    ****         return out_real;
 130:dead_fft.h    ****     }
 131:dead_fft.h    **** 
 132:dead_fft.h    ****     /**
 133:dead_fft.h    ****      * @brief Cumulative Mean-Normalized Difference Function for computation of Yin pitch detector
 134:dead_fft.h    ****      * 
 135:dead_fft.h    ****      * @param in_real real input
 136:dead_fft.h    ****      * @param N 
 137:dead_fft.h    ****      * @return float* 
 138:dead_fft.h    ****      */
 139:dead_fft.h    ****     static float* CMNDF(float* in_real, int N) {
 140:dead_fft.h    ****         float* autocorr = autocorrelate(in_real, N);
 141:dead_fft.h    **** 
 142:dead_fft.h    ****         float r0 = 0;
 143:dead_fft.h    ****         for (int n = 0; n < N; n++) {
 144:dead_fft.h    ****             r0 += in_real[n] * in_real[n];
 145:dead_fft.h    ****         }
 146:dead_fft.h    **** 
 147:dead_fft.h    ****         float sum = 0;
 148:dead_fft.h    ****         float avg;
 149:dead_fft.h    **** 
 150:dead_fft.h    ****         float* cmndf = new float[N];
 151:dead_fft.h    ****         cmndf[0] = 1.;
 152:dead_fft.h    **** 
 153:dead_fft.h    ****         for (int tau = 1; tau < N; tau++) {
 154:dead_fft.h    ****             float diff = 2. * r0 - 2. * autocorr[tau];
 155:dead_fft.h    ****             sum += diff;
 156:dead_fft.h    ****             avg = sum / static_cast<float>(tau);
 157:dead_fft.h    ****             cmndf[tau] = diff / avg;
 158:dead_fft.h    ****         }
 159:dead_fft.h    **** 
 160:dead_fft.h    ****         delete[] autocorr;
 161:dead_fft.h    **** 
 162:dead_fft.h    ****         return cmndf;
 163:dead_fft.h    ****     }
 164:dead_fft.h    **** 
 165:dead_fft.h    ****     /**
 166:dead_fft.h    ****      * @brief Finds the period of a window given the CMNDF
 167:dead_fft.h    ****      * 
 168:dead_fft.h    ****      * @param CMNDF float array of Cumulative Mean-Normalized Difference Function
 169:dead_fft.h    ****      * @param size size of the array
 170:dead_fft.h    ****      * @param thresh optional: threshold which peaks must be below. 
 171:dead_fft.h    ****      * @return the period of the window or 0
 172:dead_fft.h    ****      */
 173:dead_fft.h    ****     static int period(float* CMNDF, int size, float thresh = 0.4) {
ARM GAS  /var/folders/41/s_9r3f9s4p3_9jgx7wszdkhh0000gn/T//ccDOydHt.s 			page 162


 174:dead_fft.h    ****         int T = 0;
 175:dead_fft.h    ****         float min = thresh;
 176:dead_fft.h    **** 
 177:dead_fft.h    ****         for (int tau = 0; tau < size; tau++) {
 178:dead_fft.h    ****             // finding nearest lowest point below thresh
 179:dead_fft.h    ****             if (CMNDF[tau] < thresh) {
 180:dead_fft.h    ****                 if (CMNDF[tau] < min){
 181:dead_fft.h    ****                     min = CMNDF[tau];
 182:dead_fft.h    ****                     T = tau;
 183:dead_fft.h    ****                 }
 184:dead_fft.h    ****             }
 185:dead_fft.h    ****         }
 186:dead_fft.h    **** 
 187:dead_fft.h    ****         return T;
 188:dead_fft.h    ****     }
