  72:dead_fft.h    **** 
  73:dead_fft.h    ****     static float* autocorrelate(float* in_real, int N) {
  74:dead_fft.h    ****         C in[N*2];
  75:dead_fft.h    ****         for (int n = 0; n < N * 2; n++) {
  76:dead_fft.h    ****             if (n < N)
  77:dead_fft.h    ****                 in[n] = C(in_real[n]);
  78:dead_fft.h    ****             else 
  79:dead_fft.h    ****                 in[n] = C(0);
  80:dead_fft.h    ****         }
  81:dead_fft.h    ****         C fft[N*2];
  82:dead_fft.h    ****         FFT_recursion(in, 0, N * 2, fft, 0, 1);
  83:dead_fft.h    ****         C abs_square[N*2];
  84:dead_fft.h    **** 
  85:dead_fft.h    ****         for (int n = 0; n < N * 2; n++) {
  86:dead_fft.h    ****             abs_square[n] = fft[n] * conj(fft[n]);
  87:dead_fft.h    ****         }
  88:dead_fft.h    **** 
  89:dead_fft.h    ****         return IFFT(abs_square, N*2);
  90:dead_fft.h    ****     }
